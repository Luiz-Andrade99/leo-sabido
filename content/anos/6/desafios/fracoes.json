    "pool": "6ano.fracoes",
    "enunciado": {
      "texto": "O reator tem {partes} células iguais. Ative {fracao} delas para ligar o portal."
    },
    "parametros": {
      "tipo": "fixo",
      "partes": 12,
      "numerador": 2,
      "denominador": 3
    },
    "explicacao": "{partes} ÷ {denominador} = {umaParte}; {fracao} de {partes} = {numerador} × {umaParte} = {resposta} células.",
    "dicas": [
      "O número de baixo ({denominador}) diz em quantos grupos iguais dividir as {partes} células.",
      "Cada grupo tem {partes} ÷ {denominador} = {umaParte} células.",
      "O número de cima ({numerador}) diz quantos grupos ativar."
    ],
    "dificuldade": 1,
    "revisao": {
